# Copier ce fichier en ".env" et adapter les valeurs si necessaire.
# ".env" ne doit jamais etre commite (voir .gitignore).

# ---- Backend ----
BACKEND_PORT=8000

# ---- Frontend (utilise a partir de l'etape 5) ----
FRONTEND_PORT=4200

# ---- MongoDB (utilise a partir de l'etape 6) ----
MONGO_URI=mongodb://mongodb:27017/ffe_chess

# ---- Milvus (utilise a partir de l'etape 3) ----
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
EMBEDDING_MODEL_NAME=

# ---- Services externes (utilises a partir de l'etape 2/4) ----
LICHESS_API_BASE=https://lichess.org/api
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=

# --- Stockfish (utilise a partir de l'etape 2) ----
# --- Stockfish (optionnel : defaut /usr/games/stockfish si non defini) --
STOCKFISH_PATH=/usr/games/stockfish


POLYGLOT_BOOK_PATH=